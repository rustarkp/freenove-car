[Unit]
Description=Freenove Pi Car Streaming Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/freenove1/Freenove_4WD_Smart_Car_Kit_for_Raspberry_Pi
ExecStart=/home/freenove1/Freenove_4WD_Smart_Car_Kit_for_Raspberry_Pi/.venv/bin/python /home/freenove1/Freenove_4WD_Smart_Car_Kit_for_Raspberry_Pi/streaming_server.py
Restart=always
RestartSec=5
User=freenove1
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
